---
// Solo el subconjunto latino (español): menos @font-face y menos CSS (Misión 3).
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/nunito/latin-400.css';
import '@fontsource/nunito/latin-700.css';
// Precarga de las dos fuentes de la primera pantalla (H1 y texto): evita saltos de diseño (CLS).
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import nunito400 from '@fontsource/nunito/files/nunito-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, ANALYTICS } from '../config';
import { url } from '../utils';

interface Props {
  title: string;          // <title>: máx. ~60 caracteres, keyword al principio
  description: string;    // meta description: máx. ~155 caracteres
  image?: string;         // imagen para redes (ruta dentro de public/)
  imageAlt?: string;      // texto alternativo de esa imagen
  type?: 'website' | 'article';
  noindex?: boolean;
  landing?: boolean;      // landing: cabecera sin menú para no distraer
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = 'img/og-culilab.jpg',
  imageAlt = 'CuliLab, escuela online de ciencia y técnica culinaria',
  type = 'website',
  noindex = false,
  landing = false,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nunito400} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#a30e06" />
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/img/isotipo-180.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {ANALYTICS.searchConsoleVerification && (
      <meta name="google-site-verification" content={ANALYTICS.searchConsoleVerification} />
    )}
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {ANALYTICS.ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4}`}></script>
        <script is:inline define:vars={{ id: ANALYTICS.ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header landing={landing} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
